
{
  "manifest_version": 3,
  "name": "YTKeys",
  "version": "1.1.0",
  "description": "10-second video controls, skip-ad shortcut and RGB ambient lighting for YouTube.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_title": "YouTube RGB Controls",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["scripts/content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ]
}
